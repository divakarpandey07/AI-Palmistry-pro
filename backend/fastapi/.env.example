# AI Palmistry Pro Environment Variables Configuration Template
# Copy this file to .env and fill in your credentials

# Production AES-256-GCM Secret Key (Must be exactly 32 bytes)
AES_SECRET_KEY=12345678901234567890123456789012

# Supabase Vector Database Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Groq Llama-3 API Key
GROQ_API_KEY=gsk_your_groq_api_key_here

# HuggingFace Inference API Key
HF_API_KEY=hf_your_huggingface_api_key_here

# Dev unsecure mode fallback flag (Set to false in production)
DEV_ALLOW_UNSECURE=true
