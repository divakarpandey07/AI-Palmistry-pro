# AI Palmistry Pro Environment Variables Configuration Template
# Copy this file to .env and fill in your credentials

# Production AES-256-GCM Secret Key (Must be set to a secure 32-byte string)
AES_SECRET_KEY=REPLACE_WITH_YOUR_32_BYTE_SECRET_KEY_FROM_SECRETS_MANAGER

# Supabase Vector Database Credentials
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Groq Llama-3 API Key
GROQ_API_KEY=gsk_your_groq_api_key_here

# HuggingFace Inference API Key
HF_API_KEY=hf_your_huggingface_api_key_here
